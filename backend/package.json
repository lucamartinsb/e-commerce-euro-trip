    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.14",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
